# Admin login. This account can invite others from the Users page,
# has no daily limits, and its password always follows this value.
AUTH_USERNAME=admin
AUTH_PASSWORD=change-me
# Long random string used to sign the session cookie
AUTH_SECRET=replace-with-a-long-random-string

# JSearch on RapidAPI: https://rapidapi.com/letscrape-6bRBa3QguO5/api/jsearch
RAPIDAPI_KEY=

# Anthropic API key for resume parsing and job matching
ANTHROPIC_API_KEY=
# Optional model override
ANTHROPIC_MODEL=claude-sonnet-5-5

# Database. Set both for Turso (required on Vercel); leave empty to use a local
# SQLite file in DATA_DIR (Docker overrides DATA_DIR to /data).
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=
DATA_DIR=./data

# Daily limits per non-admin user (UTC days)
MATCH_DAILY_LIMIT=5
COVER_DAILY_LIMIT=20
